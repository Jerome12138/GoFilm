# GoFilm 部署环境变量模板. 拷贝为 .env 并填入实际值.
# .env 文件已在 .gitignore 中, 不会被 commit.

# ============ Nginx ============
NGINX_PORT=80

# ============ MySQL ============
# root 仅用于初始化, 业务用 MYSQL_USER/MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_strong_password
MYSQL_DATABASE=FilmSite
MYSQL_USER=gofilm
MYSQL_PASSWORD=CHANGE_ME_app_strong_password

# ============ Redis ============
# 容器内 redis 启用密码; 留空会让 redis 启动失败 (强制要求设密码)
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ============ JWT ============
# 二选一:
#  (A) 直接把 PEM 文本贴这里 (注意换行 → "\n" 转义, 或者用 Compose 的 multiline syntax)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
#  (B) 或者挂载到容器文件路径 (推荐生产):
#      把 PEM 放进 film/secrets/, 取消注释 compose 里的 volumes; 这里填容器内路径.
# JWT_PRIVATE_KEY_FILE=/etc/gofilm/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_FILE=/etc/gofilm/secrets/jwt_public.pem

# 不要使用代码仓库里的 DEV 密钥. 生成新对:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# 历史所有 token 自动失效, 用户需要重新登录.

# ============ CORS ============
# 逗号分隔, 例: https://film.example.com,https://admin.example.com
# 不设置则只允许本地 dev origins (生产不能这样)
CORS_ALLOWED_ORIGINS=
